# ---- the launch (required) ----
TOKEN_ADDRESS=                 # pons v2 token on Robinhood Chain, paired with ETH (curve + creator wallet are read from the factory)
REQUIRE_NATIVE=true            # refuse launches paired with anything but ETH
LAUNCH_BLOCK=                  # optional: block of the launch tx (else Blockscout / back-walk)

# ---- the engine wallet = the launch's creatorFeeRecipient ----
# private key (0x + 64 hex). Leave the placeholder to run in WATCH mode (dry blasts, nothing moves).
WALLET_PRIVATE_KEY=PASTE_PRIVATE_KEY_HERE
WALLET_ADDRESS=                # optional in watch mode: address to read the pot from (defaults to creatorFeeRecipient)
DRY_RUN=false                  # true: compute blasts, send nothing
SCHEDULER_ENABLED=true         # master kill switch: false = API + page up, no claims, no buys, no burns

# ---- blast rules ----
BLAST_INTERVAL_SEC=180         # one blast every 3 minutes, fixed clock from genesis
MIN_CLAIM_ETH=0.0002           # don't bother claiming dust
MIN_BUY_ETH=0.0005             # a pot under this rolls into the next blast
GAS_RESERVE_ETH=0.002          # ETH kept in the wallet for gas, never spent on buys
SLIPPAGE_PCT=5
POLL_SEC=10
INDEX_MS=3000

# ---- brand ----
BRAND_NAME=BLAST
SITE_URL=https://blast.example
BRAND_TWITTER=
BRAND_TELEGRAM=

# ---- infra ----
DATABASE_URL=postgres://localhost:5432/blastrh
RPC_URL=                       # primary RPC (Chainstack etc.); public fallbacks are built in
PORT=4000
QUOTE_USD=                     # override ETH/USD (else DeFiLlama)
